# Normalize line endings: store text as LF in the repo, auto-detect binaries.
* text=auto eol=lf

# Windows-only scripts keep CRLF on checkout.
*.ps1 text eol=crlf

# Treat common assets as binary (no line-ending conversion / diffing).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
