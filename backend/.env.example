# AAURIKAA backend environment variable names.
# Copy to .env and fill in values locally. Do not commit secrets.

# Core
NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_TEST_URI=
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
API_BASE_URL=http://localhost:5000

# SMTP
MAIL_USER=
MAIL_PASS=

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
MEDIA_NAMING_V2=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_CHANNEL_ID=

# PhonePe Standard Checkout V2 (OAuth)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=UAT
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/success
PHONEPE_CALLBACK_URL=

# Disable background payment reconciliation cron (optional)
# DISABLE_PAYMENT_VERIFICATION_CRON=true

# Bulk product import — enable Excel (.xlsx) uploads (CSV always supported)
# ENABLE_XLSX_IMPORT=true

# Career module rollout — public API-driven careers pages (default off until verification)
# USE_NEW_CAREER_MODULE=true
# IP_HASH_SALT=

# Point L RBAC — permission enforcement (REQUIRED in production)
# Production startup fails unless PERMISSION_ENFORCEMENT=true
PERMISSION_ENFORCEMENT=true
# PERMISSION_ENFORCED_DOMAINS=*
# Note: order_returns is always enforced when NODE_ENV=production

# After-Sales SLA automation (seller reminder + admin escalation)
# AFTER_SALES_SLA_REMINDER_HOURS=24
# AFTER_SALES_SLA_ESCALATION_HOURS=48
# AFTER_SALES_SLA_CRON=*/15 * * * *
# DISABLE_AFTER_SALES_SLA_CRON=true
# AFTER_SALES_APPEAL_WINDOW_DAYS=7

# Reverse logistics
# DISABLE_REVERSE_LOGISTICS=true
# REVERSE_LOGISTICS_PROVIDER=shiprocket

# Local Super Admin seed (npm run seed:admin). Development only.
# SEED_ADMIN_NAME=Super Admin
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@aaurikaa.local
# SEED_ADMIN_PHONE=+1234567890
# SEED_ADMIN_PASSWORD=Admin@123456

# AAURIKAA single-business foundation
# Marketplace HTTP surfaces (public seller registration, public seller storefront)
# are disabled unless explicitly re-enabled. Do not commit secrets.
# AAURIKAA_ENABLE_MARKETPLACE_SURFACES=true
# AAURIKAA_SINGLE_STORE_MODE=false
# AAURIKAA_INTERNAL_SELLER_USERNAME=aaurikaa-internal
# AAURIKAA_INTERNAL_SELLER_EMAIL=ops-internal@aaurikaa.invalid
# Placeholder Shiprocket pickup id until a real location is synced. Do not send live Shiprocket requests from this value.
# AAURIKAA_DEFAULT_PICKUP_SHIPROCKET_ID=900000001
